{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA Forge test cases",
  "type": "object",
  "required": ["test_cases"],
  "properties": {
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "requirement_ids", "priority", "steps"],
        "properties": {
          "id": {"type": "string", "pattern": "^TC-[A-Z0-9]+(-[A-Z0-9]+)*$"},
          "title": {"type": "string", "minLength": 5},
          "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "type": {"enum": ["functional", "negative", "boundary", "security", "performance", "accessibility", "usability", "compatibility", "regression", "smoke"]},
          "level": {"enum": ["unit", "api", "integration", "e2e", "ui", "manual-exploratory"]},
          "priority": {"enum": ["P1", "P2", "P3", "P4"]},
          "risk": {"enum": ["high", "medium", "low"]},
          "technique": {"type": "string"},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "test_data": {"type": "object"},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["action", "expected"],
              "properties": {"action": {"type": "string"}, "expected": {"type": "string"}}
            }
          },
          "automation": {
            "type": "object",
            "properties": {
              "candidate": {"type": "boolean"},
              "status": {"enum": ["not_automated", "in_progress", "automated", "not_feasible"]},
              "framework": {"type": "string"},
              "path": {"type": "string"}
            }
          },
          "tags": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
